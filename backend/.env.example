# MongoDB connection string (required — the server exits if this is missing)
MONGO_URI=your_mongodb_connection_string

# Port the API listens on
PORT=5001

# Bearer token required by POST /api/certificates (required, min 32 chars).
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=your_long_random_admin_token

# Comma-separated list of browser origins allowed to call this API.
ALLOWED_ORIGINS=http://localhost:5173,https://vedantdubey.com
